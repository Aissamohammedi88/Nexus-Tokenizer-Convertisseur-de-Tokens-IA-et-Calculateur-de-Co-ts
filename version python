function analyser(){
const texte = document.getElementById('texte').value;
const t = texte.toLowerCase();

let score = 0;
const details = {};

// Détecter hooks
const hooks = [];
const hookPatterns = [
["curiosité", ["personne ne parle", "j'ai passé", "voici ce que", "j'ai découvert"]],
["contraste", ["on t'a menti", "tout le monde dit", "la vérité", "mythe"]],
["urgence", ["avant qu'il", "maintenant", "dernière chance", "24h"]],
["storytelling", ["il y a", "un jour", "j'étais", "à 22 ans", "à 30 ans"]],
["numérique", ["1.", "2.", "3.", "4.", "5.", "choses", "leçons", "erreurs"]],
["question", ["?", "tu fais", "pourquoi", "savais-tu"]],
];
for(const [type, kws] of hookPatterns){
if(kws.some(k => t.includes(k))) hooks.push(type);
}

// Détecter power words
const powerWords = [];
const pw = {
curiosité: ["secret","caché","interdit","découvrir"],
urgence: ["maintenant","avant","urgent"],
autorité: ["prouvé","vérifié","testé"],
émotion: ["incroyable","choquant","terrifiant"],
exclusivité: ["exclusif","rare","unique"],
gain: ["gratuit","facile","rapide"],
douleur: ["erreur","danger","piège"],
};
for(const [cat, mots] of Object.entries(pw)){
for(const m of mots){ if(t.includes(m)) powerWords.push(m); }
}

// Emojis
const emojis = (texte.match(/[\u{1F300}-\u{1FAFF}]/gu) || []).length;

// Structure
let structure = "Non détectée";
if(/\n\d+[\.\)]\s/.test(texte)) structure = "Listicle";
else if(texte.trim().endsWith("?")) structure = "Question";
else if(t.includes("problème") && t.includes("solution")) structure = "PAS";
else if(t.includes("avant") && t.includes("après")) structure = "BAB";

// Score
score += Math.min(hooks.length * 10, 30);
score += Math.min(powerWords.length * 5, 25);
score += Math.min(emojis * 5, 15);
if(structure !== "Non détectée") score += 20;
const nbMots = texte.split(/\s+/).length;
if(nbMots > 200) score += 10;
else if(nbMots > 50) score += 5;

score = Math.min(score, 100);

// Affichage
document.getElementById('resultat').style.display = 'block';
document.getElementById('scoreCircle').style.setProperty('--p', score + '%');
document.getElementById('scoreNum').textContent = score;

document.getElementById('analyseDetail').innerHTML = `
<div class="analyse-block">
<h3>🎣 Hooks détectés</h3>
${hooks.length ? hooks.map(h => '<span class="tag good">' + h + '</span>').join('') : '<span class="tag bad">Aucun hook détecté</span>'}
</div>
<div class="analyse-block">
<h3>⚡ Power words</h3>
${powerWords.length ? powerWords.map(w => '<span class="tag good">' + w + '</span>').join('') : '<span class="tag bad">Aucun power word</span>'}
</div>
<div class="analyse-block">
<h3>📐 Structure</h3>
<span class="tag ${structure !== 'Non détectée' ? 'good' : 'bad'}">${structure}</span>
</div>
<div class="analyse-block">
<h3>📏 Longueur</h3>
<span class="tag">${nbMots} mots</span>
<span class="tag">${emojis} emoji(s)</span>
</div>
`;
}
</script>
