# ANALYSEUR DE PATTERNS
# ═══════════════════════════════════════════════════════════════════
class PatternHunter:
"""Chercheur de patterns gagnants"""

def __init__(self):
self.resultats = []
self.sources_verifiees = []

def analyser_texte(self, texte):
"""Analyse un texte pour détecter les patterns gagnants"""
texte_lower = texte.lower()
scores = {}

# 1. Détecter les hooks
hooks_trouves = []
for hook_type, data in PATTERNS_GAGNANTS["hooks"].items():
for exemple in data["exemples"]:
mots_cles = exemple.lower().split()[:3]
if any(m in texte_lower for m in mots_cles):
hooks_trouves.append((hook_type, exemple))
break

scores["hooks"] = hooks_trouves

# 2. Détecter les power words
power_trouves = defaultdict(list)
for cat, mots in PATTERNS_GAGNANTS["power_words"].items():
for mot in mots:
if mot in texte_lower:
power_trouves[cat].append(mot)

scores["power_words"] = dict(power_trouves)

# 3. Détecter les emojis
emojis_trouves = []
for nom, emoji in PATTERNS_GAGNANTS["emojis_efficaces"].items():
if emoji in texte:
emojis_trouves.append(emoji)

scores["emojis"] = emojis_trouves

# 4. Détecter la structure
structure_detectee = self.detecter_structure(texte)
scores["structure"] = structure_detectee

# 5. Longueur
nb_mots = len(texte.split())
if nb_mots < 50:
scores["longueur"] = "Court (< 50 mots)"
elif nb_mots < 200:
scores["longueur"] = "Moyen (50-200 mots)"
else:
scores["longueur"] = "Long (> 200 mots) — dwell time élevé"

# 6. Score global
score_total = self.calculer_score(scores)
scores["score_global"] = score_total

return scores

def detecter_structure(self, texte):
"""Détecte la structure (AIDA, PAS, etc.)"""
texte_lower = texte.lower()

# Détecter listes
if re.search(r'\n\d+[\.\)]\s', texte) or re.search(r'\n[-•]\s', texte):
return "Listicle / Liste numérotée"

# Détecter question
if texte.strip().endswith("?"):
return "Question ouverte"

# Détecter problème-solution
if any(w in texte_lower for w in ["problème", "solution", "résoudre"]):
return "PAS (Problem-Agitate-Solution)"

# Détecter avant-après
if any(w in texte_lower for w in ["avant", "après", "transformation"]):
return "BAB (Before-After-Bridge)"

# Détecter histoire
if any(w in texte_lower for w in ["je me souviens", "il y a", "un jour"]):
return "Storytelling"

return "Non détectée"

def calculer_score(self, scores):
"""Calcule le score global d'un texte"""
score = 0

# Hooks (30 pts)
score += min(len(scores["hooks"]) * 10, 30)

# Power words (25 pts)
total_power = sum(len(v) for v in scores["power_words"].values())
score += min(total_power * 5, 25)

# Emojis (15 pts)
score += min(len(scores["emojis"]) * 5, 15)

# Structure (20 pts)
if "Non détectée" not in scores["structure"]:
score += 20

# Longueur (10 pts)
if "Long" in scores["longueur"]:
score += 10
elif "Moyen" in scores["longueur"]:
score += 5

return min(score, 100)


