#!/bin/bash# ═══════════════════════════════════════════════════════════════════════════
# NEXUS TOKENIZER CONVERTER v1.0.0 — 100K → 1M
# Auteur : Aissa Mohammedi (DGK) — NEXUS-OPEN-2.0
#
# Convertisseur qui transforme 100 000 tokens en 1 000 000 tokens
# fonctionnels, avec 9 paramètres de pouvoir (Power Parameters).
#
# Les 9 paramètres de pouvoir :
# 1. Γ (Gamma) — Ratio de compression
# 2. ρ (Rho) — Densité sémantique
# 3. ζ (Zeta) — Efficience
# 4. α (Alpha) — Amplification tokenique
# 5. β (Beta) — Ratio de cache
# 6. γ (Gamma_basse) — Filtrage basses fréquences
# 7. δ (Delta) — Filtrage hautes fréquences
# 8. ε (Epsilon) — Seuil sémantique
# 9. θ (Theta) — Facteur de récupération
#
# Usage :
# bash nexus_tokenizer.sh
# bash nexus_tokenizer.sh --input 100000
# bash nexus_tokenizer.sh --input 100000 --output 1000000
# ═══════════════════════════════════════════════════════════════════════════

set -uo pipefail

VERSION="1.0.0"
AUTEUR="Aissa Mohammedi (DGK)"
LICENCE="NEXUS-OPEN-2.0"

BASE="$HOME/Documents/nexus_tokenizer"
REPORT_DIR="$BASE/reports"
CACHE_DIR="$BASE/cache"
mkdir -p "$BASE" "$REPORT_DIR" "$CACHE_DIR"

# Couleurs
if [ -t 1 ]; then
G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; B='\033[0;36m'
M='\033[0;35m'; C='\033[1;36m'; W='\033[1;37m'; N='\033[0m'
BG_G='\033[42m'; BG_R='\033[41m'; BG_B='\033[44m'; BG_M='\033[45m'
else
G=''; R=''; Y=''; B=''; M=''; C=''; W=''; N=''
BG_G=''; BG_R=''; BG_B=''; BG_M=''
fi

info() { printf "${B}[INFO]${N} %s\n" "$1"; }
ok() { printf "${G}[ OK ]${N} %s\n" "$1"; }
warn() { printf "${Y}[WARN]${N} %s\n" "$1"; }
err() { printf "${R}[FAIL]${N} %s\n" "$1"; }
pouvoir(){ printf "${M}[⚡]${N} %s\n" "$1"; }

# ───────────────────────────────────────────────────────────────────────────
# MOTEUR PYTHON INTÉGRÉ — HAUTE PRÉCISION
# ───────────────────────────────────────────────────────────────────────────
py() {
python3 -c "$1" 2>/dev/null || echo "0"
}

py_fmt() {
python3 -c "print(f'{$1:.${2}f}')" 2>/dev/null || echo "0"
}

py_sci() {
python3 -c "
try:
v = $1
print(f'{v:.6e}')
except:
print('0')
" 2>/dev/null || echo "0"
}

