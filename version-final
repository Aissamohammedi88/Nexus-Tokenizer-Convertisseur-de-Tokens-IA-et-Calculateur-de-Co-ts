# ═══════════════════════════════════════════════════════════════════════════
# CONVERTISSEUR INTERACTIF
# ═══════════════════════════════════════════════════════════════════════════
INTERACTIF() {
section "CONVERTISSEUR INTERACTIF"
printf " Entre un nombre de tokens (ou 'q' pour quitter) : "
read -r tk

while [ -n "$tk" ] && [ "$tk" != "q" ]; do
if [[ "$tk" =~ ^[0-9]+$ ]]; then
local octets=$(py "$tk * 4")
local mo=$(py_fmt "$octets / 1048576" 4)
local go=$(py_fmt "$octets / 1073741824" 6)

echo ""
printf " ${W}%d tokens${N}\n" "$tk"
printf " Octets : %d\n" "$octets"
printf " Mo : %s\n" "$mo"
printf " Go : %s\n" "$go"
echo ""
printf " Coût par modèle :\n"

for modele in gemini-pro gemini-flash gpt4 claude-sonnet deepseek-v3; do
local input="${M_INPUT[$modele]}"
local cache="${M_CACHE[$modele]}"
local cout_i=$(py "($tk / 1000000) * $input")
local cout_c=$(py "($tk / 1000000) * $cache")

printf " %-18s input: \$%-14s cache: \$%-14s\n" \
"$modele" "$(py_fmt "$cout_i" 8)" "$(py_fmt "$cout_c" 8)"
done
echo ""
else
printf " ${R}Entrée invalide${N}\n"
fi

printf " Entre un nombre de tokens (ou 'q' pour quitter) : "
read -r tk
done
}

# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════
main() {
local tokens_in=100000
local tokens_out=1000000

# Parse args
while [ $# -gt 0 ]; do
case "$1" in
--input) tokens_in="$2"; shift 2 ;;
--output) tokens_out="$2"; shift 2 ;;
--help|-h)
echo "Usage: $0 [--input 100000] [--output 1000000]"
exit 0
;;
*) shift ;;
esac
done

# Vérifier Python
if ! command -v python3 >/dev/null 2>&1; then
err "Python3 requis pour les calculs haute précision"
exit 1
fi

banniere

# ═══ ÉTAPE 1 : INIT DB ═══
init_db
echo ""

# ═══ ÉTAPE 2 : CONFIG ═══
section "CONFIGURATION"
printf " Tokens d'entrée : %d\n" "$tokens_in"
printf " Tokens de sortie : %d\n" "$tokens_out"
printf " Ratio cible : %sx\n" "$(py_fmt "$(py "$tokens_out / $tokens_in")" 2)"
echo ""

# ═══ ÉTAPE 3 : CONVERSION ═══
TOKENIZER_CONVERT "$tokens_in" "$tokens_out"

# ═══ ÉTAPE 4 : TABLEAU ═══
TABLEAU_COMPARATIF "$TOKENS_FINAUX"

# ═══ ÉTAPE 5 : VALEUR ═══
VALEUR_REELLE "$TOKENS_FINAUX"

# ═══ ÉTAPE 6 : RÉSUMÉ ═══
echo ""
result "✅ CONVERSION RÉUSSIE"
echo ""
printf " Entrée : %d tokens\n" "$tokens_in"
printf " Sortie : %d tokens\n" "$TOKENS_FINAUX"
printf " Amplification : %sx\n" "$(py_fmt "$AMPLIFICATION" 4)"
printf " Compression : %s\n" "$(py_fmt "$COMPRESSION" 4)"
printf " Hash : %s\n" "$HASH_FINAL"
echo ""

# ═══ ÉTAPE 7 : SAUVEGARDE ═══
save_to_db "$tokens_in" "$TOKENS_FINAUX"
save_reports "$tokens_in" "$TOKENS_FINAUX"

# ═══ ÉTAPE 8 : INTERACTIF ═══
INTERACTIF

# ═══ FIN ═══
echo ""
printf "${G}═══════════════════════════════════════════════════════════════════════════${N}\n"
printf "${G} ✅ NEXUS TOKENIZER v${VERSION} — TERMINÉ${N}\n"
printf "${G}═══════════════════════════════════════════════════════════════════════════${N}\n"
echo ""
printf " 📁 Base de données : %s\n" "$DB_FILE"
printf " 📁 Rapports : %s\n" "$REPORT_DIR"
printf " 📁 Cache : %s\n" "$CACHE_DIR"
echo ""
}

main "$@"
