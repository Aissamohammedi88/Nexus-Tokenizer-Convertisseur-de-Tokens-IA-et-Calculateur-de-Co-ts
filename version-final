#
# Convertisseur qui transforme 100 000 tokens en 1 000 000+ tokens fonctionnels
# avec 9 paramètres de pouvoir (Power Parameters) + moteur de compression
# sémantique + visualisation temps réel + export multi-format.
#
# LES 9 PARAMÈTRES DE POUVOIR :
# 1. Γ (Gamma) — Ratio de compression
# 2. ρ (Rho) — Densité sémantique
# 3. ζ (Zeta) — Efficience
# 4. α (Alpha) — Amplification tokenique
# 5. β (Beta) — Ratio de cache
# 6. γ_basse — Filtrage basses fréquences
# 7. δ (Delta) — Filtrage hautes fréquences
# 8. ε (Epsilon) — Seuil sémantique
# 9. θ (Theta) — Facteur de récupération
# ═══════════════════════════════════════════════════════════════════════════

set -uo pipefail

VERSION="2.0.0"
AUTEUR="Aissa Mohammedi (DGK)"
LICENCE="NEXUS-OPEN-2.0"

# ─── Répertoires ───────────────────────────────────────────────────────────
BASE_DIR="$HOME/Documents/nexus_tokenizer_v2"
REPORT_DIR="$BASE_DIR/reports"
CACHE_DIR="$BASE_DIR/cache"
EXPORT_DIR="$BASE_DIR/exports"
LOG_DIR="$BASE_DIR/logs"
DB_FILE="$BASE_DIR/tokenizer.db"

mkdir -p "$BASE_DIR" "$REPORT_DIR" "$CACHE_DIR" "$EXPORT_DIR" "$LOG_DIR"

# ─── Couleurs ──────────────────────────────────────────────────────────────
if [ -t 1 ]; then
G=$'\033[0;32m'; R=$'\033[0;31m'; Y=$'\033[1;33m'; B=$'\033[0;36m'
M=$'\033[0;35m'; C=$'\033[1;36m'; W=$'\033[1;37m'; N=$'\033[0m'
BG_G=$'\033[42m'; BG_R=$'\033[41m'; BG_B=$'\033[44m'; BG_M=$'\033[45m'
else
G=''; R=''; Y=''; B=''; M=''; C=''; W=''; N=''
BG_G=''; BG_R=''; BG_B=''; BG_M=''
fi

# ─── Fonctions d'affichage ─────────────────────────────────────────────────
info() { printf "${B}[INFO]${N} %s\n" "$1"; }
ok() { printf "${G}[ OK ]${N} %s\n" "$1"; }
warn() { printf "${Y}[WARN]${N} %s\n" "$1"; }
err() { printf "${R}[FAIL]${N} %s\n" "$1"; }
pouvoir() { printf "${M}[⚡]${N} %s\n" "$1"; }
section() { printf "\n${BG_B}${W} ═══ %s ═══ ${N}\n\n" "$1"; }
result() { printf "${BG_G}${W} %s ${N}\n" "$1"; }

# ─── Moteur Python intégré (calculs haute précision) ───────────────────────
py() {
python3 -c "print($1)" 2>/dev/null || echo "0"
}

py_fmt() {
local val="$1"
local prec="${2:-4}"
python3 -c "
try:
v = $val
print(f'{v:.${prec}f}')
except:
print('0')
" 2>/dev/null || echo "0"
}

py_sci() {
python3 -c "
try:
v = $1
print(f'{v:.6e}')
except:
print('0')
" 2>/dev/null || echo "0"
}

