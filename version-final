# ─── Tableau comparatif ────────────────────────────────────────────────────
TABLEAU_COMPARATIF() {
local tokens="$1"

section "TABLEAU COMPARATIF MULTI-MODÈLES"

printf " ${W}%-20s %-12s %-14s %-14s %-14s %-10s${N}\n" \
"Modèle" "Provider" "Input $" "Cache $" "Total $" "Économie"
printf " %s\n" "──────────────────────────────────────────────────────────────────────────────────────"

# Trouver moins cher et plus cher
local moins_cher=999999
local modele_moins_cher=""
local plus_cher=0
local modele_plus_cher=""

for modele in "${LISTE_MODELES[@]}"; do
local input="${M_INPUT[$modele]}"
local cache="${M_CACHE[$modele]}"
local output="${M_OUTPUT[$modele]}"
local provider="${M_PROVIDER[$modele]}"

local cout_input=$(py "($tokens / 1000000) * $input")
local cout_cache=$(py "($tokens / 1000000) * $cache")
local cout_output=$(py "($tokens / 1000000) * $output")
local total_cache=$(py "$cout_cache + $cout_output")
local economie=$(py "(1 - $cache / $input) * 100")

printf " %-20s %-12s %-14s %-14s %-14s %5s%%\n" \
"$modele" "$provider" \
"$(py_fmt "$cout_input" 6)" \
"$(py_fmt "$cout_cache" 6)" \
"$(py_fmt "$total_cache" 6)" \
"$(py_fmt "$economie" 1)"

# Comparer pour trouver extremes
local tc=$(py "int($total_cache * 1000000)")
local mc=$(py "int($moins_cher * 1000000)")
local pc=$(py "int($plus_cher * 1000000)")

if [ "$tc" -lt "$mc" ]; then
moins_cher="$total_cache"
modele_moins_cher="$modele"
fi
if [ "$tc" -gt "$pc" ]; then
plus_cher="$total_cache"
modele_plus_cher="$modele"
fi
done

echo ""
printf " 🏆 Moins cher : ${G}%s${N} (\$%s)\n" "$modele_moins_cher" "$(py_fmt "$moins_cher" 6)"
printf " 💸 Plus cher : ${R}%s${N} (\$%s)\n" "$modele_plus_cher" "$(py_fmt "$plus_cher" 6)"
local ratio=$(py "$plus_cher / $moins_cher")
printf " 📊 Ratio : %sx\n" "$(py_fmt "$ratio" 1)"
echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
# CALCUL DE LA VALEUR RÉELLE
# ═══════════════════════════════════════════════════════════════════════════
VALEUR_REELLE() {
local tokens="$1"

section "CALCUL DE LA VALEUR RÉELLE"

local energie="1e-9"
local temps="1e-9"
local rarete="1.0"

local valeur_token=$(py "$energie * $temps * $rarete")
local valeur_totale=$(py "$valeur_token * $tokens")

local prix_signal_1m=50.00
local valeur_signal_1m=$(py "$valeur_token * 1000000")
local ratio_fraude=$(py "$prix_signal_1m / $valeur_signal_1m")

printf " Formule : Valeur = Énergie × Temps × Rareté\n"
printf " Énergie : %s Wh/token\n" "$energie"
printf " Temps : %s s/token\n" "$temps"
printf " Rareté : %s\n" "$rarete"
echo ""
printf " ${W}Valeur d'un token : \$$(py_sci "$valeur_token")${N}\n"
printf " ${W}Valeur %d tokens : \$$(py_sci "$valeur_totale")${N}\n" "$tokens"
echo ""
printf " Prix signal marché : \$%s / 1M\n" "$prix_signal_1m"
printf " Valeur réelle 1M : \$$(py_sci "$valeur_signal_1m")\n"
printf " ${R}Ratio de fraude : $(py_sci "$ratio_fraude")x${N}\n"
echo ""
}

